<?xml version="1.0"?>

<package format="3">

  <name>intera_core_msgs</name>

  <version>0.1.0</version>

  <description>
    ROS 2 interfaces for the Rethink Robotics Intera SDK.
  </description>

  <maintainer email="todo@example.com">
    Sawyer ROS 2 Migration
  </maintainer>

  <license>Apache-2.0</license>


  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <build_depend>
    rosidl_default_generators
  </build_depend>

  <exec_depend>
    rosidl_default_runtime
  </exec_depend>


  <depend>
    std_msgs
  </depend>

  <depend>
    geometry_msgs
  </depend>

  <depend>
    sensor_msgs
  </depend>


  <member_of_group>
    rosidl_interface_packages
  </member_of_group>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>